# ══════════════════════════════════════════════════════════════════════════════
#  PR Reviewer Bot — Environment Variables
#
#  Copy this file to `.env` and fill in your values. Only DISCORD_WEBHOOK_URL is
#  required; every other variable has a sensible default (shown as its value here).
# ══════════════════════════════════════════════════════════════════════════════


# ── GitHub ────────────────────────────────────────────────────────────────────

# Personal Access Token. Optional if you've run `gh auth login`.
# Scopes needed: repo, read:org
GH_TOKEN=ghp_your_token_here

# GitHub username whose review requests the bot watches for.
GH_REVIEWER=reviewer-github-username

# ── Discord ───────────────────────────────────────────────────────────────────

# Incoming webhook URL for posting review notifications.          [REQUIRED]
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url-here

# Bot token + channel ID for receiving manual review commands.    [optional]
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here


# ── Bot identity ──────────────────────────────────────────────────────────────

# Name and avatar shown in logs and Discord messages.
BOT_NAME=pr-reviewer-bot
BOT_AVATAR_URL=https://github.com/github.png


# ── Server & runtime ──────────────────────────────────────────────────────────

# HTTP server port.
PORT=3000

# Log verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# How often (in minutes) the poller checks GitHub for new review requests.
POLL_INTERVAL_MIN=5

# Days to keep completed PR entries in the state file before pruning.
STATE_RETENTION_DAYS=30


# ── PR review · repo clone ────────────────────────────────────────────────────

# Clone the PR branch locally for standalone agents. Hermes uses the selected
# profile's remote GitHub read-only path, so local cloning is skipped for it.
# Set to "false" or "0" to disable local cloning for other agents too.
PR_CLONE_ENABLED=true

# Shallow clone depth (number of commits). Increase if merge-base failures occur.
PR_CLONE_DEPTH=200

# Timeout (ms) for the entire clone operation.
PR_CLONE_TIMEOUT_MS=90000


# ── PR review · agent ─────────────────────────────────────────────────────────

# Which agent process to spawn for the review:
#     hermes (recommended) | codex | claude | opencode
# Each standalone agent reads its own model var below; Hermes uses its profile's
# model/provider/auth and performs read-only GitHub exploration on that profile's
# terminal backend.
REVIEW_AGENT=hermes

# hermes — named Hermes profile. Default: work.
# The profile must have valid provider auth and GitHub read access on its backend.
HERMES_PROFILE=work

# claude — short alias (e.g. "opus", "sonnet"). Default: opus.
REVIEW_MODEL=opus

# opencode — "provider/model" form (e.g. "google/gemini-2.5-flash").
# Leave unset to use opencode's own configured default.
# NOTE: opencode's OpenAI models are blocked on a ChatGPT-account OAuth host —
# use REVIEW_AGENT=codex for OpenAI instead. (google/* models worked here.)
OPENCODE_MODEL=google/gemini-2.5-flash

# codex — bare model name (e.g. "gpt-5.5", "gpt-5.2-codex", "gpt-5.1-codex-max").
# Leave unset to use codex's own default (~/.codex/config.toml).
# Uses the official OpenAI Codex CLI, which works with ChatGPT-account OAuth.
CODEX_MODEL=gpt-5.5

# codex reasoning effort. Leave unset to use Codex CLI default.
# Supported: minimal | low | medium | high | xhigh
CODEX_REASONING_EFFORT=xhigh

# Per-review timeout (minutes). The agent is SIGTERM'd after this, then SIGKILL'd
# 30s later. Increase if reviews on large PRs keep timing out.
REVIEW_TIMEOUT_MIN=50

# On SIGTERM/SIGINT, stop accepting new work and wait for in-flight primary,
# Ponytail, verifier, publish, and reply-monitor work. Default is
# REVIEW_TIMEOUT_MIN * 3 + 5 minutes; PM2's hard-kill timeout is 4 hours.
# SHUTDOWN_GRACE_TIMEOUT_MIN=155

# Max PRs reviewed concurrently (caps memory from concurrent agents).
REVIEW_CONCURRENCY=3


# ── Review comment reply monitor ─────────────────────────────────────────────

# When enabled, the bot scans recent reviewed PRs for human replies to the bot's
# GitHub review comments and posts an additional answer when the agent determines
# that a reply is needed.
REPLY_MONITOR_ENABLED=true

# Limit reply-monitor scans to PRs reviewed within the last N days to reduce API
# usage. Set to 0 or leave empty to scan all stored reviewed PRs.
REPLY_MONITOR_LOOKBACK_DAYS=14


# ── Review memory / team conventions ─────────────────────────────────────────

# Archive human replies to bot review comments and inject curated repo-scoped
# lessons into future reviews. Set false to skip both raw archive and prompt
# injection for privacy-sensitive deployments.
REVIEW_MEMORY_ENABLED=true

# Max active repository lessons injected into a single review prompt.
REVIEW_MEMORY_MAX_LESSONS=8

# Source-controlled organization review-wiki directory. The bot reads only
# <GitHub organization>.md with matching `owner:` frontmatter. Repository
# discussion is never promoted here automatically.
# Default: docs/review-wiki
REVIEW_WIKI_DIRECTORY=docs/review-wiki

# Max characters stored per raw comment/diff hunk in state/review-memory.json.
# Minimum accepted value is 100.
REVIEW_MEMORY_RAW_MAX_CHARS=4000

# Days to retain archived raw review discussion entries. Active curated lessons
# are kept until manually archived/rejected.
REVIEW_MEMORY_RETENTION_DAYS=180
